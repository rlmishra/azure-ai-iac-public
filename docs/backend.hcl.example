# Illustrative names only; no account keys, tokens or secrets.
resource_group_name  = "rg-approved-state"
storage_account_name = "approvedstateaccount"
container_name       = "terraform"
key                  = "enterprise-ai/dev/foundation.tfstate"
use_azuread_auth     = true
# For an approved federated runner, also set use_oidc = true and configure
# its ARM_* identity/token-delivery environment externally.

# For an approved Azure-hosted managed identity runner, select use_msi = true
# instead of use_oidc, and supply the intended client_id externally if required.
# The runner also needs private blob DNS/routing and state-container data RBAC.
# Identity settings do not create private endpoints or bootstrap storage.
